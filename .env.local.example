# Universal AI Provider Configuration (OpenAI-compatible)
# Works with OpenRouter, Groq, OpenAI, Together, DeepSeek, Local Ollama, or OmniRoute.

# 1. API Base URL (e.g. your OmniRoute gateway or AI provider)
AI_BASE_URL=http://localhost:20128/v1

# 2. API Key (leave empty if your local gateway requires no auth)
AI_API_KEY=

# 3. Model Configuration (Optional)
# All models can be chosen and switched directly from the web UI (Settings -> Advanced)!
# You only need to set these if you want to override the default starting models:
# MODEL_PLANNER=antigravity/claude-sonnet-4-6
# MODEL_VALIDATOR=antigravity/gemini-3.8-flash-low
# MODEL_FALLBACK=auto/best-fast
# MODEL_IMAGE=antigravity/gemini-3.1-flash-image


