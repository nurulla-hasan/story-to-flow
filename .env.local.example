# Universal AI Provider Configuration (OpenAI-compatible)
# Works with OpenRouter, Groq, OpenAI, Together, DeepSeek, Local Ollama, or OmniRoute.

# 1. API Base URL (default is http://localhost:20128/v1 for local OmniRoute)
# Examples:
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenAI:      https://api.openai.com/v1
#   Ollama:      http://localhost:11434/v1
#   OmniRoute:   http://localhost:20128/v1
AI_BASE_URL=http://localhost:20128/v1

# 2. API Key (leave empty for local models like Ollama without auth)
AI_API_KEY=

# 3. Model Names
# Examples:
#   OpenRouter:  google/gemini-2.5-flash OR anthropic/claude-3.5-haiku
#   Groq:        llama-3.3-70b-versatile
#   OpenAI:      gpt-4o-mini
#   OmniRoute:   agy/gemini-3.8-flash-high
MODEL_PLANNER=agy/gemini-3.8-flash-high
MODEL_FALLBACK=ollamacloud/gemma4:31b

