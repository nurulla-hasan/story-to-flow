{
  "manifest_version": 3,
  "name": "Story to Flow - Auto Bridge",
  "version": "1.0.0",
  "description": "Connects Story-to-Flow with Google Flow (flow.google.com) to automatically transfer prompts, attach starting frames, and run generations.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*",
    "https://*.vercel.app/*",
    "*://flow.google.com/*",
    "*://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/*"
      ],
      "js": ["flow-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
